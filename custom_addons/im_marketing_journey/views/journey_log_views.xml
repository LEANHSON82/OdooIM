<odoo>
    <record id="action_im_journey_log" model="ir.actions.act_window">
        <field name="name">Nhật ký thực thi &amp; gửi tin</field>
        <field name="res_model">im.journey.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_im_journey_log_tree" model="ir.ui.view">
        <field name="name">im.journey.log.list</field>
        <field name="model">im.journey.log</field>
        <field name="arch" type="xml">
            <list string="Nhật ký thực thi &amp; gửi tin" create="false" edit="false">
                <field name="execution_time"/>
                <field name="journey_id"/>
                <field name="lead_id"/>
                <field name="node_id"/>
                <field name="run_number" string="Lượt" optional="show"/>
                <field name="action_type" widget="badge"/>
                <field name="status" widget="badge" 
                       decoration-success="status == 'success'" 
                       decoration-danger="status == 'failed'" 
                       decoration-warning="status == 'postponed'"/>
                <field name="message_content"/>
            </list>
        </field>
    </record>

    <record id="view_im_journey_log_search" model="ir.ui.view">
        <field name="name">im.journey.log.search</field>
        <field name="model">im.journey.log</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm nhật ký thực thi">
                <field name="lead_id"/>
                <field name="journey_id"/>
                <filter string="Zalo ZNS" name="zns" domain="[('action_type', '=', 'zns')]"/>
                <filter string="Email" name="email" domain="[('action_type', '=', 'email')]"/>
                <group>
                    <filter string="Kịch bản" name="group_journey" context="{'group_by': 'journey_id'}"/>
                    <filter string="Kênh gửi tin" name="group_action" context="{'group_by': 'action_type'}"/>
                    <filter string="Trạng thái" name="group_status" context="{'group_by': 'status'}"/>
                </group>
            </search>
        </field>
    </record>
</odoo>
