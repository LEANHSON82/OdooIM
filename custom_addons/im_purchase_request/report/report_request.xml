<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_purchase_request" model="ir.actions.report">
        <field name="name">Phiếu đề nghị mua hàng</field>
        <field name="model">im.purchase.request</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">im_purchase_request.report_request_document</field>
        <field name="report_file">im_purchase_request.report_request_document</field>
        <field name="print_report_name">'Phiếu đề nghị mua hàng - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_im_purchase_request"/>
        <field name="binding_type">report</field>
    </record>

    <template id="report_request_document">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">

                        <h2 class="text-center mb-1">PHIẾU ĐỀ NGHỊ MUA HÀNG</h2>
                        <p class="text-center text-muted mb-4">
                            <span t-field="doc.name"/>
                        </p>

                        <div class="row mb-4">
                            <div class="col-6">
                                <strong>Người đề nghị:</strong>
                                <span t-field="doc.requester_id"/><br/>
                                <strong>Bộ phận:</strong>
                                <span t-field="doc.department_id"/>
                            </div>
                            <div class="col-6">
                                <strong>Ngày đề nghị:</strong>
                                <span t-field="doc.date_request"/><br/>
                                <t t-if="doc.date_required">
                                    <strong>Ngày cần hàng:</strong>
                                    <span t-field="doc.date_required"/>
                                </t>
                            </div>
                        </div>

                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <th class="text-start">STT</th>
                                    <th class="text-start">Nội dung</th>
                                    <th class="text-end">Số lượng</th>
                                    <th class="text-start">Đơn vị tính</th>
                                    <th class="text-end">Đơn giá dự toán</th>
                                    <th class="text-end">Thành tiền</th>
                                    <th class="text-start">NCC gợi ý</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="doc.line_ids" t-as="line">
                                    <td><span t-esc="line_index + 1"/></td>
                                    <td><span t-field="line.name"/></td>
                                    <td class="text-end">
                                        <span t-field="line.product_qty"/>
                                    </td>
                                    <td><span t-field="line.product_uom_id"/></td>
                                    <td class="text-end">
                                        <span t-field="line.price_unit"
                                              t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                    <td class="text-end">
                                        <span t-field="line.price_subtotal"/>
                                    </td>
                                    <td><span t-field="line.partner_id"/></td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr class="border-black o_total">
                                    <td colspan="5" class="text-end"><strong>Tổng dự toán</strong></td>
                                    <td class="text-end"><strong><span t-field="doc.amount_total"/></strong></td>
                                    <td/>
                                </tr>
                                <tr t-if="doc.extra_cost_total">
                                    <td colspan="5" class="text-end">
                                        Trong đó trả thêm vì không chọn nguồn rẻ nhất
                                    </td>
                                    <td class="text-end">
                                        <span t-field="doc.extra_cost_total"/>
                                    </td>
                                    <td/>
                                </tr>
                            </tfoot>
                        </table>

                        <div class="mt-4" t-if="doc.line_ids.quote_ids">
                            <strong>So sánh nguồn mua</strong>
                            <table class="table table-sm mt-2">
                                <thead>
                                    <tr>
                                        <th class="text-start">Nội dung</th>
                                        <th class="text-start">Nhà cung cấp</th>
                                        <th class="text-end">Đơn giá</th>
                                        <th class="text-end">Chênh</th>
                                        <th class="text-start">Nguồn gốc</th>
                                        <th class="text-start">Tình trạng</th>
                                        <th class="text-end">Bảo hành</th>
                                        <th class="text-start">Thanh toán</th>
                                        <th class="text-start">Ghi chú chất lượng</th>
                                        <th class="text-center">Chọn</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="doc.line_ids" t-as="line">
                                        <tr t-foreach="line.quote_ids" t-as="quote">
                                            <td>
                                                <span t-if="quote_index == 0"
                                                      t-field="line.name"/>
                                            </td>
                                            <td><span t-field="quote.partner_id"/></td>
                                            <td class="text-end">
                                                <span t-field="quote.price_unit"
                                                      t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                            </td>
                                            <td class="text-end">
                                                <span t-if="quote.price_diff"
                                                      t-field="quote.price_diff"/>
                                            </td>
                                            <td><span t-field="quote.origin_type"/></td>
                                            <td><span t-field="quote.condition"/></td>
                                            <td class="text-end">
                                                <span t-if="quote.warranty_months"
                                                      t-field="quote.warranty_months"/>
                                                <span t-if="quote.warranty_months"> tháng</span>
                                            </td>
                                            <td><span t-field="quote.payment_term_id"/></td>
                                            <td><span t-field="quote.quality_note"/></td>
                                            <td class="text-center">
                                                <span t-if="quote.is_chosen">✔</span>
                                            </td>
                                        </tr>
                                        <tr t-if="line.selection_reason">
                                            <td/>
                                            <td colspan="9">
                                                <em>Lý do chọn:
                                                    <span t-field="line.selection_reason"/>
                                                </em>
                                            </td>
                                        </tr>
                                    </t>
                                </tbody>
                            </table>
                        </div>

                        <div t-if="doc.note" class="mt-3">
                            <strong>Lý do đề nghị:</strong>
                            <div t-field="doc.note"/>
                        </div>

                        <div t-if="doc.refuse_reason" class="mt-3">
                            <strong>Lý do từ chối:</strong>
                            <div t-field="doc.refuse_reason"/>
                        </div>

                        <div class="row mt-5" t-if="doc.approval_ids">
                            <div class="col-3 text-center">
                                <strong>Người đề nghị</strong>
                                <div class="text-muted" style="font-size: 0.8em;">
                                    (ký, ghi rõ họ tên)
                                </div>
                                <div style="height: 70px;"/>
                                <span t-field="doc.requester_id"/>
                            </div>
                            <t t-foreach="doc.approval_ids" t-as="approval">
                                <div class="col-3 text-center">
                                    <strong><span t-field="approval.level_id.name"/></strong>
                                    <div class="text-muted" style="font-size: 0.8em;">
                                        (ký, ghi rõ họ tên)
                                    </div>
                                    <div style="height: 70px;">
                                        <div t-if="approval.state == 'approved'"
                                             class="text-muted mt-4"
                                             style="font-size: 0.75em;">
                                            Đã duyệt điện tử bởi
                                            <span t-field="approval.user_id"/><br/>
                                            lúc <span t-field="approval.date"/>
                                        </div>
                                        <div t-if="approval.state == 'refused'"
                                             class="mt-4" style="font-size: 0.75em;">
                                            <strong>ĐÃ TỪ CHỐI</strong><br/>
                                            <span t-field="approval.user_id"/>
                                        </div>
                                    </div>
                                    <span t-if="approval.user_id" t-field="approval.user_id"/>
                                </div>
                            </t>
                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
