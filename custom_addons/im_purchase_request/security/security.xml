<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_purchase_request" model="ir.module.category">
        <field name="name">Đề nghị mua hàng</field>
        <field name="description">Approval levels for internal purchase requests.</field>
        <field name="sequence">18</field>
    </record>

    <record id="group_dept_manager" model="res.groups">
        <field name="name">Trưởng bộ phận</field>
        <field name="sequence">10</field>
        <field name="privilege_id" eval="False"/>
        <field name="im_is_approver_role" eval="True"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="group_purchase_manager" model="res.groups">
        <field name="name">Trưởng phòng vật tư</field>
        <field name="sequence">20</field>
        <field name="privilege_id" eval="False"/>
        <field name="im_is_approver_role" eval="True"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user'), ref('purchase.group_purchase_user')])]"/>
    </record>

    <record id="group_director" model="res.groups">
        <field name="name">Giám đốc</field>
        <field name="sequence">30</field>
        <field name="privilege_id" eval="False"/>
        <field name="im_is_approver_role" eval="True"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user'), ref('account.group_account_readonly')])]"/>
    </record>

    <record id="group_manager" model="res.groups">
        <field name="name">Quản trị đề nghị mua hàng</field>
        <field name="sequence">40</field>
        <field name="privilege_id" eval="False"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
    </record>

    <record id="group_product_creator" model="res.groups">
        <field name="name">Tạo sản phẩm mới trên đề nghị mua hàng</field>
    </record>

    <record id="group_vendor_creator" model="res.groups">
        <field name="name">Tạo nhà cung cấp mới trên đề nghị mua hàng</field>
    </record>

