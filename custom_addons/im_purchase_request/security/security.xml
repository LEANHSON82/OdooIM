            <field name="name">Purchase Request Approval Level: multi-company</field>
            <field name="model_id" ref="model_im_purchase_request_approval_level"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('company_id', '=', False),
                                            ('company_id', 'in', company_ids)]</field>
        </record>

        <function model="res.groups" name="write"
                  eval="[[ref('group_manager')], {'user_ids': [(4, ref('base.user_admin'))]}]"/>

