    <record id="approval_overrun_approver_rule" model="ir.rule">
        <field name="name">Purchase Request Approval: overrun approvers see ordered requests</field>
        <field name="model_id" ref="model_im_purchase_request_approval"/>
        <field name="domain_force">[('request_id.state', '=', 'po_created'),
            ('request_id.company_id.im_config_ids', 'any', [
                ('overrun_approval_mode', '=', 'limited'),
                ('overrun_rule_ids', 'any', ['|', ('group_ids', 'in', user.all_group_ids.ids),
                                                  ('user_ids', 'in', [user.id])])])]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>

    <record id="config_company_rule" model="ir.rule">
        <field name="name">Purchase Request Config: multi-company</field>
        <field name="model_id" ref="model_im_purchase_request_config"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

    <record id="permission_company_rule" model="ir.rule">
        <field name="name">Purchase Request Permission: multi-company</field>
        <field name="model_id" ref="model_im_purchase_request_permission"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>

    <record id="quote_rule_company_rule" model="ir.rule">
        <field name="name">Purchase Request Quote Rule: multi-company</field>
        <field name="model_id" ref="model_im_purchase_request_quote_rule"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
