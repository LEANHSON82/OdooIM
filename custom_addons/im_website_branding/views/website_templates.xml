<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Priority 99 makes us run last, after website.brand_promotion
         and website_sale.brand_promotion inherit the same block.
         Removing it earlier breaks their xpath and the whole page. -->
    <template id="hide_brand_promotion"
              inherit_id="web.brand_promotion"
              priority="99"
              name="Gỡ khối quảng bá Odoo ở chân trang">
        <xpath expr="//div[hasclass('o_brand_promotion')]" position="replace"/>
    </template>
</odoo>
