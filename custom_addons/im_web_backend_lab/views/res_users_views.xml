<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_users_preferences_form_im" model="ir.ui.view">
        <field name="name">res.users.preferences.form.im_web_backend</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_preferences']" position="inside">
                <label for="x_color_scheme" string="Theme"/>
                <div>
                    <field name="x_color_scheme"
                           widget="radio"
                           options="{'horizontal': true}"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>