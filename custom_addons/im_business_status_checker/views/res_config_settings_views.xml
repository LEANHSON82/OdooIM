<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form_business_status" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.business.status</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Tra cứu đăng ký doanh nghiệp" string="Tra cứu đăng ký doanh nghiệp"
                     name="im_business_status_checker" groups="base.group_system">
                    <block title="Dịch vụ captcha" name="im_captcha_container">
                        <setting string="Dịch vụ"
                                 help="Cổng chặn bằng reCAPTCHA, cần khóa dịch vụ để tra cứu.">
                            <field name="im_captcha_provider"/>
                            <div class="content-group mt16" invisible="im_captcha_provider == 'none'">
                                <div>
                                    <label for="im_captcha_api_key" class="o_light_label"/>
                                    <field name="im_captcha_api_key" password="True"/>
                                </div>
                                <div>
                                    <label for="im_captcha_timeout" class="o_light_label"/>
                                    <field name="im_captcha_timeout" class="oe_inline"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Vận hành" name="im_runtime_container">
                        <setting string="Cấu hình tra cứu hàng đợi"
                                 help="Áp dụng cho cron tra cứu. Đặt lô lớn quá hoặc thử lại nhiều quá thì cổng dễ chặn.">
                            <div class="content-group">
                                <div>
                                    <label for="im_batch_size" class="o_light_label"/>
                                    <field name="im_batch_size" class="oe_inline"/>
                                </div>
                                <div>
                                    <label for="im_request_delay" class="o_light_label"/>
                                    <field name="im_request_delay" class="oe_inline"/>
                                </div>
                                <div>
                                    <label for="im_portal_timeout" class="o_light_label"/>
                                    <field name="im_portal_timeout" class="oe_inline"/>
                                </div>
                                <div>
                                    <label for="im_portal_retries" class="o_light_label"/>
                                    <field name="im_portal_retries" class="oe_inline"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

</odoo>
