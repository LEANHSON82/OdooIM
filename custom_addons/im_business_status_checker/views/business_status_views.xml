<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_business_status_lookup" model="ir.actions.act_window">
        <field name="name">Tra cứu tình trạng doanh nghiệp</field>
        <field name="res_model">business.status.lookup</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_business_status_list" model="ir.ui.view">
        <field name="name">business.status.check.list</field>
        <field name="model">business.status.check</field>
        <field name="arch" type="xml">
            <list string="Tình trạng doanh nghiệp" create="false"
                  js_class="business_status_list"
                  decoration-muted="state == 'queued'">
                <header>
                    <button name="%(action_business_status_lookup)d" type="action"
                            string="Tra cứu" class="btn-primary" display="always"/>
                </header>
                <field name="name"/>
                <field name="vat"/>
                <field name="status" widget="lookup_status"/>
                <field name="checked_on"/>
                <field name="state" optional="hide"/>
                <field name="note" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_business_status_form" model="ir.ui.view">
        <field name="name">business.status.check.form</field>
        <field name="model">business.status.check</field>
        <field name="arch" type="xml">
            <form string="Tình trạng doanh nghiệp">
                <header>
                    <button name="action_lookup" type="object" string="Tra cứu lại"
                            class="btn-primary" invisible="state == 'queued'"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <group>
                    <field name="name"/>
                    <field name="vat"/>
                    <field name="status" widget="badge"
                           decoration-success="status == 'active'"
                           decoration-warning="status == 'suspended'"
                           decoration-danger="status == 'inactive'"/>
                    <field name="checked_on"/>
                </group>
                <field name="note" readonly="1" nolabel="1" invisible="not note"/>
            </form>
        </field>
    </record>

    <record id="view_business_status_search" model="ir.ui.view">
        <field name="name">business.status.check.search</field>
        <field name="model">business.status.check</field>
        <field name="arch" type="xml">
            <search string="Tình trạng doanh nghiệp">
                <field name="name"/>
                <field name="vat"/>
                <separator/>
                <filter name="filter_operating" string="Còn hoạt động"
                        domain="[('is_operating', '=', True)]"/>
                <filter name="filter_not_operating" string="Không còn hoạt động"
                        domain="[('is_operating', '=', False), ('state', '=', 'done')]"/>
                <filter name="filter_queued" string="Chờ tra cứu"
                        domain="[('state', '=', 'queued')]"/>
                <filter name="filter_failed" string="Tra cứu lỗi"
                        domain="[('state', 'in', ('not_found', 'error'))]"/>
                <separator/>
                <filter name="group_status" string="Tình trạng"
                        context="{'group_by': 'status'}"/>
            </search>
        </field>
    </record>

    <record id="action_business_status_check" model="ir.actions.act_window">
        <field name="name">Tình trạng doanh nghiệp</field>
        <field name="res_model">business.status.check</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_business_status_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa tra cứu doanh nghiệp nào</p>
            <p>Bấm "Tra cứu" và nhập mã số thuế.</p>
        </field>
    </record>

    <record id="view_business_status_lookup_form" model="ir.ui.view">
        <field name="name">business.status.lookup.form</field>
        <field name="model">business.status.lookup</field>
        <field name="arch" type="xml">
            <form string="Tra cứu tình trạng doanh nghiệp">
                <field name="query" placeholder="Nhập mã số thuế hoặc tên doanh nghiệp"/>
                <footer>
                    <button name="action_lookup" type="object" string="Tra cứu"
                            class="btn-primary" data-hotkey="q"/>
                    <button string="Đóng" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>

    <menuitem id="menu_business_status_root"
              name="Tình trạng doanh nghiệp"
              action="action_business_status_check"
              web_icon="im_business_status_checker,static/description/icon.png"
              sequence="95"/>

</odoo>
