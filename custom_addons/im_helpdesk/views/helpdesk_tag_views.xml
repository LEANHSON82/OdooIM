<?xml version="1.0"?>
<!-- Giao diện backend cho tag helpdesk và cấu hình tự gắn tag theo keyword. -->
<odoo>

    <record id="helpdesk_tag_view_list" model="ir.ui.view">
        <field name="name">helpdesk.tag.list</field>
        <field name="model">helpdesk.tag</field>
        <field name="arch" type="xml">
            <list string="Tags" editable="bottom">
                <field name="name"/>
                <field name="color" widget="color_picker"/>
                <field name="auto_apply_keywords" optional="hide"/>
                <field name="auto_apply_min_score" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="helpdesk_tag_view_form" model="ir.ui.view">
        <field name="name">helpdesk.tag.form</field>
        <field name="model">helpdesk.tag</field>
        <field name="arch" type="xml">
            <form string="Tag">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                        <field name="auto_apply_min_score"/>
                        <field name="auto_apply_keywords" placeholder="e.g. bug, error, invoice, payment"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="helpdesk_tag_action" model="ir.actions.act_window">
        <field name="name">Tags</field>
        <field name="res_model">helpdesk.tag</field>
        <field name="path">helpdesk-tags</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
