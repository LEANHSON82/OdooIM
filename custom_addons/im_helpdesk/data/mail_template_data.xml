<?xml version="1.0" encoding="utf-8"?>
<!-- Mail templates for ticket notices, follower invites and rating requests. -->
<odoo><data noupdate="1">
    <record id="new_ticket_request_email_template" model="mail.template">
        <field name="name">Helpdesk: Ticket Received</field>
        <field name="model_id" ref="model_helpdesk_ticket"/>
        <field name="subject">{{ object.name }}</field>
        <field name="email_from">{{ (object.company_id.email_formatted or object.user_id.email_formatted or user.email_formatted) }}</field>
        <field name="email_to" eval="False"/>
        <field name="partner_to" eval="False"/>
        <field name="use_default_to" eval="True"/>
        <field name="description">Notify customer that their helpdesk ticket has been received.</field>
        <field name="body_html" type="html">
<div>
    Dear <t t-out="object.sudo().partner_id.name or object.sudo().partner_name or 'Madam/Sir'">Madam/Sir</t>,<br/><br/>
    Your request has been received and is being reviewed by our
    <t t-out="object.team_id.name or ''">VIP Support</t> team.<br/><br/>
    The reference for your ticket is <strong><t t-out="object.ticket_ref or ''">00001</t></strong>.<br/><br/>
    To provide any additional information, simply reply to this email.<br/><br/>
    <div style="text-align: center; padding: 16px 0px 16px 0px;">
        <a t-attf-style="background-color: #875A7B; padding: 8px 16px; text-decoration: none; color: #FFFFFF; border-radius: 5px; font-size:13px;"
           t-att-href="object.get_portal_url()" target="_blank">View Ticket</a>
    </div>
    Best regards,<br/><br/>
    <t t-out="object.team_id.name or 'Helpdesk'">Helpdesk</t> Team
</div>
        </field>
        <field name="lang">{{ object.partner_id.lang or object.user_id.lang or user.lang }}</field>
        <field name="auto_delete" eval="True"/>
    </record>

    <record id="solved_ticket_request_email_template" model="mail.template">
        <field name="name">Helpdesk: Ticket Closed</field>
        <field name="model_id" ref="model_helpdesk_ticket"/>
        <field name="subject">Ticket Closed - Reference {{ object.id if object.id else 15 }}</field>
        <field name="email_from">{{ (object.company_id.email_formatted or object.user_id.email_formatted or user.email_formatted) }}</field>
        <field name="email_to" eval="False"/>
        <field name="partner_to" eval="False"/>
        <field name="use_default_to" eval="True"/>
        <field name="body_html" type="html">
<div>
    Dear <t t-out="object.sudo().partner_id.name or 'Madam/Sir'">Madam/Sir</t>,<br/><br/>
    We would like to inform you that we have closed your ticket (reference <t t-out="object.id or ''">15</t>).
    We trust that the services provided have met your expectations.<br/><br/>
    If you have any further questions, please reply to this email to re-open your ticket.<br/><br/>
    Kind regards,<br/><br/>
    <t t-out="object.team_id.name or 'Helpdesk'">Helpdesk</t> Team.
</div>
        </field>
        <field name="lang">{{ object.partner_id.lang or object.user_id.lang or user.lang }}</field>
        <field name="auto_delete" eval="True"/>
    </record>

    <record id="rating_ticket_request_email_template" model="mail.template">
        <field name="name">Helpdesk: Ticket Rating Request</field>
        <field name="model_id" ref="model_helpdesk_ticket"/>
        <field name="subject">{{ object.company_id.name or 'Helpdesk' }}: Service Rating Request</field>
        <field name="email_from">{{ (object.company_id.email_formatted or object._rating_get_operator().email_formatted or user.email_formatted) }}</field>
        <field name="email_to" eval="False"/>
        <field name="partner_to" eval="False"/>
        <field name="use_default_to" eval="True"/>
        <field name="body_html" type="html">
<div>
    <t t-set="access_token" t-value="object._rating_get_access_token()"/>
    <t t-set="partner" t-value="object._rating_get_partner()"/>
    <t t-if="partner.name">Hello <t t-out="partner.name">Brandon Freeman</t>,<br/><br/></t>
    <t t-else="">Hello,<br/></t>
    Please take a moment to rate our services related to the ticket
    "<strong t-out="object.name or ''">Table legs are unbalanced</strong>"<br/><br/>
    <table style="width:100%;text-align:center;margin-top:2rem;">
        <tr>
            <td><a t-attf-href="/rate/{{ access_token }}/5"><img alt="Happy" src="/rating/static/src/img/rating_5.png" title="Happy"/></a></td>
            <td><a t-attf-href="/rate/{{ access_token }}/3"><img alt="Neutral" src="/rating/static/src/img/rating_3.png" title="Neutral"/></a></td>
            <td><a t-attf-href="/rate/{{ access_token }}/1"><img alt="Unhappy" src="/rating/static/src/img/rating_1.png" title="Unhappy"/></a></td>
        </tr>
    </table>
    <br/>We appreciate your feedback.
</div>
        </field>
        <field name="lang">{{ object.partner_id.lang or object.user_id.lang or user.lang }}</field>
        <field name="auto_delete" eval="True"/>
    </record>

    <template id="ticket_invitation_follower">
<div>
    Hello <t t-out="partner_name"/>,<br/><br/>
    You have been invited to follow Ticket: <t t-out="object.display_name"/>.
</div>
    </template>
</data></odoo>
