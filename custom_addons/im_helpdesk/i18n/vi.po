#. module: im_helpdesk
#: model:mail.template,body_html:im_helpdesk.rating_ticket_request_email_template
msgid ""
"<div>\n"
"    <t t-set=\"access_token\" t-value=\"object._rating_get_access_token()\"/>\n"
"    <t t-set=\"partner\" t-value=\"object._rating_get_partner()\"/>\n"
"    <t t-if=\"partner.name\">Hello <t t-out=\"partner.name\">Brandon Freeman</t>,<br/><br/></t>\n"
"    <t t-else=\"\">Hello,<br/></t>\n"
"    Please take a moment to rate our services related to the ticket\n"
"    \"<strong t-out=\"object.name or ''\">Table legs are unbalanced</strong>\"<br/><br/>\n"
"    <table style=\"width:100%;text-align:center;margin-top:2rem;\">\n"
"        <tr>\n"
"            <td><a t-attf-href=\"/rate/{{ access_token }}/5\"><img alt=\"Happy\" src=\"/rating/static/src/img/rating_5.png\" title=\"Happy\"/></a></td>\n"
"            <td><a t-attf-href=\"/rate/{{ access_token }}/3\"><img alt=\"Neutral\" src=\"/rating/static/src/img/rating_3.png\" title=\"Neutral\"/></a></td>\n"
"            <td><a t-attf-href=\"/rate/{{ access_token }}/1\"><img alt=\"Unhappy\" src=\"/rating/static/src/img/rating_1.png\" title=\"Unhappy\"/></a></td>\n"
"        </tr>\n"
"    </table>\n"
"    <br/>We appreciate your feedback.\n"
"</div>\n"
"        "
msgstr ""
"<div>\n"
"    <t t-set=\"access_token\" t-value=\"object._rating_get_access_token()\"/>\n"
"    <t t-set=\"partner\" t-value=\"object._rating_get_partner()\"/>\n"
"    <t t-if=\"partner.name\">Xin chào <t t-out=\"partner.name\">Brandon Freeman</t>,<br/><br/></t>\n"
"    <t t-else=\"\">Xin chào,<br/></t>\n"
"    Vui lòng dành chút thời gian đánh giá dịch vụ của chúng tôi liên quan đến phiếu\n"
"    \"<strong t-out=\"object.name or ''\">Chân bàn bị lệch</strong>\"<br/><br/>\n"
"    <table style=\"width:100%;text-align:center;margin-top:2rem;\">\n"
"        <tr>\n"
"            <td><a t-attf-href=\"/rate/{{ access_token }}/5\"><img alt=\"Hài lòng\" src=\"/rating/static/src/img/rating_5.png\" title=\"Hài lòng\"/></a></td>\n"
"            <td><a t-attf-href=\"/rate/{{ access_token }}/3\"><img alt=\"Bình thường\" src=\"/rating/static/src/img/rating_3.png\" title=\"Bình thường\"/></a></td>\n"
"            <td><a t-attf-href=\"/rate/{{ access_token }}/1\"><img alt=\"Không hài lòng\" src=\"/rating/static/src/img/rating_1.png\" title=\"Không hài lòng\"/></a></td>\n"
"        </tr>\n"
"    </table>\n"
"    <br/>Cảm ơn phản hồi của bạn.\n"
"</div>\n"
"        "

#. module: im_helpdesk
#: model:mail.template,body_html:im_helpdesk.solved_ticket_request_email_template
msgid ""
"<div>\n"
"    Dear <t t-out=\"object.sudo().partner_id.name or 'Madam/Sir'\">Madam/Sir</t>,<br/><br/>\n"
"    We would like to inform you that we have closed your ticket (reference <t t-out=\"object.id or ''\">15</t>).\n"
"    We trust that the services provided have met your expectations.<br/><br/>\n"
"    If you have any further questions, please reply to this email to re-open your ticket.<br/><br/>\n"
"    Kind regards,<br/><br/>\n"
"    <t t-out=\"object.team_id.name or 'Helpdesk'\">Helpdesk</t> Team.\n"
"</div>\n"
"        "
msgstr ""
"<div>\n"
"    Kính gửi <t t-out=\"object.sudo().partner_id.name or 'Quý khách'\">Quý khách</t>,<br/><br/>\n"
"    Chúng tôi xin thông báo rằng phiếu của bạn đã được đóng (tham chiếu <t t-out=\"object.id or ''\">15</t>).\n"
"    Hy vọng dịch vụ đã đáp ứng mong đợi của bạn.<br/><br/>\n"
"    Nếu bạn còn câu hỏi nào khác, vui lòng trả lời email này để mở lại phiếu.<br/><br/>\n"
"    Trân trọng,<br/><br/>\n"
"    Đội <t t-out=\"object.team_id.name or 'Hỗ trợ'\">Hỗ trợ</t>.\n"
"</div>\n"
"        "

#. module: im_helpdesk
#: model:mail.template,body_html:im_helpdesk.new_ticket_request_email_template
msgid ""
"<div>\n"
"    Dear <t t-out=\"object.sudo().partner_id.name or object.sudo().partner_name or 'Madam/Sir'\">Madam/Sir</t>,<br/><br/>\n"
"    Your request has been received and is being reviewed by our\n"
"    <t t-out=\"object.team_id.name or ''\">VIP Support</t> team.<br/><br/>\n"
"    The reference for your ticket is <strong><t t-out=\"object.ticket_ref or ''\">00001</t></strong>.<br/><br/>\n"
"    To provide any additional information, simply reply to this email.<br/><br/>\n"
"    <div style=\"text-align: center; padding: 16px 0px 16px 0px;\">\n"
"        <a t-attf-style=\"background-color: #875A7B; padding: 8px 16px; text-decoration: none; color: #FFFFFF; border-radius: 5px; font-size:13px;\" t-att-href=\"object.get_portal_url()\" target=\"_blank\">View Ticket</a>\n"
"    </div>\n"
"    Best regards,<br/><br/>\n"
"    <t t-out=\"object.team_id.name or 'Helpdesk'\">Helpdesk</t> Team\n"
"</div>\n"
"        "
msgstr ""
"<div>\n"
"    Kính gửi <t t-out=\"object.sudo().partner_id.name or object.sudo().partner_name or 'Quý khách'\">Quý khách</t>,<br/><br/>\n"
"    Yêu cầu của bạn đã được tiếp nhận và đang được đội\n"
"    <t t-out=\"object.team_id.name or ''\">Hỗ trợ VIP</t> xem xét.<br/><br/>\n"
"    Mã tham chiếu phiếu của bạn là <strong><t t-out=\"object.ticket_ref or ''\">00001</t></strong>.<br/><br/>\n"
"    Để bổ sung thông tin, bạn chỉ cần trả lời email này.<br/><br/>\n"
"    <div style=\"text-align: center; padding: 16px 0px 16px 0px;\">\n"
"        <a t-attf-style=\"background-color: #875A7B; padding: 8px 16px; text-decoration: none; color: #FFFFFF; border-radius: 5px; font-size:13px;\" t-att-href=\"object.get_portal_url()\" target=\"_blank\">Xem phiếu</a>\n"
"    </div>\n"
"    Trân trọng,<br/><br/>\n"
"    Đội <t t-out=\"object.team_id.name or 'Hỗ trợ'\">Hỗ trợ</t>\n"
"</div>\n"
"        "

