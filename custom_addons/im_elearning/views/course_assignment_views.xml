<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_course_assignment_list" model="ir.ui.view">
        <field name="name">im.course.assignment.list</field>
        <field name="model">im.course.assignment</field>
        <field name="arch" type="xml">
            <list string="Khoá học được giao"
                  decoration-danger="state in ('overdue', 'removed')"
                  decoration-success="state == 'done'"
                  decoration-muted="state == 'not_started'">
                <field name="employee_id"/>
                <field name="department_id" optional="show"/>
                <field name="channel_id"/>
                <field name="date_assigned" optional="hide"/>
                <field name="date_deadline"/>
                <field name="completion" widget="progressbar"/>
                <field name="state" widget="badge"
                       decoration-danger="state in ('overdue', 'removed')"
                       decoration-success="state == 'done'"
                       decoration-info="state == 'in_progress'"/>
                <field name="certificate_id" optional="hide"/>
                <field name="manager_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_course_assignment_form" model="ir.ui.view">
        <field name="name">im.course.assignment.form</field>
        <field name="model">im.course.assignment</field>
        <field name="arch" type="xml">
            <form string="Khoá học được giao">
                <header>
                    <button name="action_open_course" type="object" string="Mở khoá học"
                            class="btn-primary"/>
                    <button name="action_reenroll" type="object" string="Ghi danh lại"
                            class="btn-secondary" invisible="state != 'removed'"/>
                    <field name="state" widget="statusbar"
                           statusbar_visible="not_started,in_progress,done"/>
                    <field name="is_enrolled" invisible="1"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="department_id"/>
                            <field name="manager_id"/>
                            <field name="partner_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="channel_id"/>
                            <field name="date_assigned"/>
                            <field name="date_deadline"/>
                        </group>
                    </group>
                    <group string="Tiến độ">
                        <group>
                            <field name="completion" widget="progressbar"/>
                            <field name="member_status"/>
                        </group>
                        <group>
                            <field name="certificate_id"/>
                            <field name="reminder_sent"/>
                            <field name="overdue_notified"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_course_assignment_search" model="ir.ui.view">
        <field name="name">im.course.assignment.search</field>
        <field name="model">im.course.assignment</field>
        <field name="arch" type="xml">
            <search string="Khoá học được giao">
                <field name="employee_id"/>
                <field name="channel_id"/>
                <field name="department_id"/>
                <filter name="filter_not_started" string="Chưa bắt đầu"
                        domain="[('state', '=', 'not_started')]"/>
                <filter name="filter_in_progress" string="Đang học"
                        domain="[('state', '=', 'in_progress')]"/>
                <filter name="filter_overdue" string="Quá hạn"
                        domain="[('state', '=', 'overdue')]"/>
                <filter name="filter_done" string="Đã xong"
                        domain="[('state', '=', 'done')]"/>
                <filter name="filter_removed" string="Bị gỡ khỏi khoá"
                        domain="[('state', '=', 'removed')]"/>
                <separator/>
                <filter name="filter_my_team" string="Cấp dưới của tôi"
                        domain="[('manager_id.user_id', '=', uid)]"/>
                <group>
                    <filter name="group_channel" string="Khoá học" context="{'group_by': 'channel_id'}"/>
                    <filter name="group_department" string="Phòng ban" context="{'group_by': 'department_id'}"/>
                    <filter name="group_employee" string="Nhân viên" context="{'group_by': 'employee_id'}"/>
                    <filter name="group_deadline" string="Hạn" context="{'group_by': 'date_deadline'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_course_assignment_graph" model="ir.ui.view">
        <field name="name">im.course.assignment.graph</field>
        <field name="model">im.course.assignment</field>
        <field name="arch" type="xml">
            <graph string="Tiến độ đào tạo" sample="1">
                <field name="department_id"/>
                <field name="completion" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_course_assignment_pivot" model="ir.ui.view">
        <field name="name">im.course.assignment.pivot</field>
        <field name="model">im.course.assignment</field>
        <field name="arch" type="xml">
            <pivot string="Tiến độ đào tạo" sample="1">
                <field name="department_id" type="row"/>
                <field name="channel_id" type="col"/>
                <field name="completion" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_course_assignment" model="ir.actions.act_window">
        <field name="name">Khoá học được giao</field>
        <field name="res_model">im.course.assignment</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Chưa giao khoá học nào</p>
            <p>Giao khoá học cho nhân viên hoặc cả phòng ban kèm hạn hoàn thành.
               Hệ thống tự nhắc trước hạn và báo khi quá hạn.</p>
        </field>
    </record>

    <record id="view_course_assignment_wizard_form" model="ir.ui.view">
        <field name="name">im.course.assignment.wizard.form</field>
        <field name="model">im.course.assignment.wizard</field>
        <field name="arch" type="xml">
            <form string="Giao khoá học">
                <group>
                    <field name="channel_id"/>
                    <field name="date_deadline"/>
                </group>
                <group>
                    <field name="employee_ids" widget="many2many_tags"/>
                    <field name="department_ids" widget="many2many_tags"/>
                </group>
                <div class="text-muted">
                    Chọn nhân viên, hoặc chọn phòng ban để giao cho toàn bộ phòng ban
                    đó (gồm cả các phòng ban con). Người đã được giao khoá này sẽ được bỏ qua.
                </div>
                <footer>
                    <button name="action_assign" type="object" string="Giao" class="btn-primary"/>
                    <button special="cancel" string="Huỷ" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_course_assignment_wizard" model="ir.actions.act_window">
        <field name="name">Giao khoá học</field>
        <field name="res_model">im.course.assignment.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
